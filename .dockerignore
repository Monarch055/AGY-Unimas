# Ignore node_modules from host machine
**/node_modules
**/.next
**/.turbo

# Ignore version control and logs
.git
.github
*.log
npm-debug.log*

# Ignore python caches and virtualenvs
**/__pycache__
**/.pytest_cache
**/.venv
**/venv
*.pyc

# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore documentation artifacts and local temporary directories
.Artifacts
