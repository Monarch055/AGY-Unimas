{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InventoryScanResponse",
  "type": "object",
  "required": ["request_id", "detected_materials", "total_items_detected", "active_hazards"],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "detected_materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["material_id", "canonical_name", "localized_name", "quantity", "confidence", "bounding_box"],
        "properties": {
          "material_id": { "type": "string" },
          "canonical_name": { "type": "string" },
          "localized_name": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "bounding_box": {
            "type": "object",
            "required": ["ymin", "xmin", "ymax", "xmax"],
            "properties": {
              "ymin": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "xmin": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "ymax": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "xmax": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          }
        }
      }
    },
    "total_items_detected": {
      "type": "integer",
      "minimum": 0
    },
    "active_hazards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_type", "severity", "warning_title", "warning_message", "conflicting_materials", "recommended_action"],
        "properties": {
          "alert_type": { "type": "string" },
          "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"] },
          "warning_title": { "type": "string" },
          "warning_message": { "type": "string" },
          "conflicting_materials": {
            "type": "array",
            "items": { "type": "string" }
          },
          "recommended_action": { "type": "string" }
        }
      }
    }
  }
}
