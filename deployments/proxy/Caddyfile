{
    # Global options
    auto_https off
}

# Ingress Router for RekaSains
:80 {
    # Core Control Plane API forwarding
    handle /v1/* {
        reverse_proxy core-api:8080
    }

    # Google ADK AI Agent & Official Dev UI forwarding
    handle /dev-ui* {
        reverse_proxy ai-agent:8081
    }
    handle /list-apps* {
        reverse_proxy ai-agent:8081
    }
    handle /apps/* {
        reverse_proxy ai-agent:8081
    }
    handle /dev/* {
        reverse_proxy ai-agent:8081
    }
    handle /run* {
        reverse_proxy ai-agent:8081
    }
    handle /ai/v1/* {
        reverse_proxy ai-agent:8081
    }

    # Health check
    handle /healthz {
        respond "OK" 200
    }

    # Frontend Mobile-First PWA forwarding
    handle /* {
        reverse_proxy web:3000
    }
}
