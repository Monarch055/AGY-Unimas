# ==============================================================================
# Environment Configuration for RekaSains Monorepo
# Reference: docs/setup/ENV-VARIABLES.md
# ==============================================================================

# Application Environment
APP_ENV=development
APP_PORT=8080
AI_AGENT_PORT=8081
LOG_LEVEL=debug
DEFAULT_REGION=ID

# Frontend Public Config (`apps/web`)
NEXT_PUBLIC_API_URL=http://localhost:8080/v1
NEXT_PUBLIC_APP_NAME=RekaSains

# Internal Service-to-Service Discovery (Direct REST & SSE)
AI_AGENT_BASE_URL=http://localhost:8081/ai/v1
AI_AGENT_URL=http://localhost:8081/ai/v1
CORE_API_URL=http://localhost:8080/v1
INTERNAL_SERVICE_TIMEOUT_SEC=30

# Google ADK & Gemini Configuration (`services/ai-agent`)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Database (PostgreSQL 16 - Owned by `services/core-api`)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rekasains
DB_SSLMODE=disable

# Cache (Valkey / Redis 7.2)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Reverse Proxy Ingress (Caddy)
INGRESS_PORT=80

# JWT / Security Secrets
JWT_SECRET=super-secret-development-key-change-me-in-production
JWT_EXPIRY_HOURS=24
